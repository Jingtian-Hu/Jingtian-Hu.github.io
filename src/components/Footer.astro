---
import Icon from "./Icon.astro";
import { site, links } from "../data/site";
---
<footer class="site-footer">
  <div class="wrap row">
    <ul class="links">
      {links.map((l) => (
        <li><a href={l.href}><Icon name={l.icon} /><span>{l.label}</span></a></li>
      ))}
    </ul>
    <p class="label">© {new Date().getFullYear()} {site.name} · Last updated {site.lastUpdated}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 1.75rem 2.5rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .links {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-small);
    color: var(--muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--accent-deep);
  }
  .links :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  p {
    margin: 0;
  }
</style>
